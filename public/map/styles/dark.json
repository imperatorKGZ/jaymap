{
  "version": 8,
  "name": "MapKG Dark",
  "metadata": {
    "mapkg:purpose": "Custom minimalist dark map style for the MapKG long-term rental real-estate platform. A calm background layer for price markers, selected-listing highlight, clusters, filters, search, routes and search-area polygons drawn by the frontend — not a navigation or tourist map.",
    "mapkg:schema": "OpenMapTiles (unmodified — as served by OpenFreeMap)",
    "mapkg:tile_source": "https://tiles.openfreemap.org/planet — free public OpenFreeMap instance, no API key, no request limits, self-hostable (see https://github.com/hyperknot/openfreemap)",
    "mapkg:fonts": "OpenFreeMap public glyph server, generated from openmaptiles/fonts. Verified available combos: 'Noto Sans Regular', 'Noto Sans Bold', 'Noto Sans Italic'. No 'Medium' weight exists on this server, so it is not used anywhere in this style.",
    "mapkg:sprite": "Not used. No icon-image is referenced anywhere in this style (all POI/marker icons live in the frontend UI, not the basemap), so no sprite sheet is required.",
    "mapkg:compatibility": "MapLibre GL JS, Style Specification v8. No Mapbox-only expressions or properties.",
    "mapkg:bishkek_bbox_note": "The Bishkek downtown bbox used below (74.585,42.865 to 74.625,42.885) is a hand-picked rectangle covering the historic grid center; adjust or duplicate for other cities in docs/LAYERS.md."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
